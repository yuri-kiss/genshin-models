{
  "compilerOptions": {
    "experimentalDecorators": false,
    "target": "esnext",
    "moduleDetection": "auto",
    "module": "es6",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "declaration": false,
    "outDir": "./dist",
    "moduleResolution": "bundler",
    "lib": [
      "DOM", "DOM.AsyncIterable", "DOM.Iterable",
      "ES5", "ES6",
      "ES2015", "ES2015.Collection", "ES2015.Core", "ES2015.Generator", "ES2015.Iterable", "ES2015.Promise", "ES2015.Proxy", "ES2015.Reflect", "ES2015.Symbol", "ES2015.Symbol.WellKnown",
      "ES2016", "ES2016.Array.Include", "ES2017", "ES2017.ArrayBuffer", "ES2017.Date", "ES2017.Intl", "ES2017.Object", "ES2017.SharedMemory", "ES2017.String", "ES2017.TypedArrays",
      "ES2018", "ES2018.AsyncGenerator", "ES2018.AsyncIterable", "ES2018.Intl", "ES2018.Promise", "ES2018.Regexp",
      "ES2019", "ES2019.Array", "ES2019.Intl", "ES2019.Object", "ES2019.String", "ES2019.Symbol",
      "ES2020",
    ],
  },
  "include": [
    "./src/**/*",
    "./src/*",
  ],
  "exclude": [
    "./node_modules",
    "./dist",
    "./webpack.config.cjs"
  ],
}
